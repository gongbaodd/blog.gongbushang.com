---
import GitHub from "../../src/icons/github.svg?raw";
import Twitter from "../../src/icons/x.svg?raw";
import Linkedin from "../../src/icons/linkedin.svg?raw";
import Instagram from "../../src/icons/instagram.svg?raw";
import Threads from "../../src/icons/threads.svg?raw";
import Youtube from "../../src/icons/youtube.svg?raw";
import Spotify from "../../src/icons/spotify.svg?raw";
import Itchio from "../../src/icons/itchdotio.svg?raw";
import Jike from "../../src/icons/jike.svg?raw";
import Xiaohongshu from "../../src/icons/xiaohongshu.svg?raw";
import Facebook from "../../src/icons/facebook.svg?raw";
import Bilibili from "../../src/icons/bilibili.svg?raw";
import v2ex from "../../src/icons/v2ex.svg?raw";
import MantineFooter from "@/packages/footer/MantineFooter";
import ViewCount from "@/src/components/ViewCount";
import OpenSource from "./fragments/opensource.mdx"

// Brand icons are raw SVG files injected via `set:html`. They previously
// went through `@lucide/astro`'s `<Icon set:html={...} />` (which rendered
// a wrapper `<svg class="lucide">` around the injected content). Lucide
// 1.47 requires a real icon name and no longer supports that pattern, so
// the wrapper is now a native <svg> with the same attributes the Icon
// component used to render (verified against the Astro 6 baseline HTML).
---

<MantineFooter>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    width="24"
    height="24"
    stroke="none"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    fill="currentcolor"
    aria-hidden="true"
    class="lucide"
    slot="iconGithub"
    set:html={GitHub}
  />
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    width="24"
    height="24"
    stroke="none"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    fill="currentcolor"
    aria-hidden="true"
    class="lucide"
    slot="iconItchio"
