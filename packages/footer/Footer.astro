    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    width="24"
    height="24"
    stroke="none"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    fill="currentcolor"
    aria-hidden="true"
    class="lucide"
    slot="iconTwitter"
    set:html={Twitter}
  />
