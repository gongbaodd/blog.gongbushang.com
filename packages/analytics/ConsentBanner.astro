---
const enabled = Boolean(import.meta.env.PUBLIC_MIXPANEL_TOKEN);
---

{
  enabled && (
    <div
      id="analytics-consent"
      role="region"
      aria-label="Analytics consent"
      hidden
      class="analytics-consent"
    >
      <p>
        This site uses Mixpanel analytics to understand how posts are read and searched.
        <a href="/privacy">Privacy</a>. Allow?
      </p>
      <div class="analytics-consent-actions">
        <button type="button" data-consent="allow">Allow</button>
        <button type="button" data-consent="deny">No thanks</button>
      </div>
    </div>
  )
}

<script>
  import { getConsent, optIn, optOut } from "./index";

  const banner = document.getElementById("analytics-consent");
  if (banner) {
    const hide = () => {
      banner.hidden = true;
    };
    if (getConsent() === "unset") banner.hidden = false;
    banner.addEventListener("click", (event) => {
      const btn = (event.target as Element).closest<HTMLElement>("[data-consent]");
      if (!btn) return;
      if (btn.dataset.consent === "allow") optIn();
      else optOut();
      hide();
    });
  }
</script>

<style is:global>
  .analytics-consent {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1000;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem 1rem;
    padding: 0.625rem 1rem;
    font-size: 0.875rem;
    background: #fff;
    color: #1a1b1e;
    border-top: 1px solid #ced4da;
  }
  .analytics-consent[hidden] {
    display: none;
  }
  .analytics-consent a {
    text-decoration: underline;
  }
  .analytics-consent-actions {
    display: flex;
    gap: 0.5rem;
  }
  .analytics-consent button {
    padding: 0.25rem 0.75rem;
    border: 1px solid currentColor;
    border-radius: 0.375rem;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  .analytics-consent button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }
  [data-mantine-color-scheme="dark"] .analytics-consent {
    background: #1a1b1e;
    color: #c9c9c9;
    border-top-color: #373a40;
  }
</style>
