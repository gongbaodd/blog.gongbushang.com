---
const enabled = Boolean(import.meta.env.PUBLIC_MIXPANEL_TOKEN);
---

{
  enabled && (
    <script>
      import { initAnalytics } from "./index";
      import { installOutboundTracking } from "./outbound";

      const start = () => {
        void initAnalytics();
        installOutboundTracking();
      };
      if ("requestIdleCallback" in window) {
        window.requestIdleCallback(start);
      } else {
        setTimeout(start, 1);
      }
    </script>
  )
}
