---
// Draft preview target (GON-250). EMDASH_PREVIEW_PATH_PATTERN is `/{collection}/{id}` (astro.config.mjs, GON-270), so the param is the entry id or slug. 403 unless a valid `_preview` token grants this entry.
import PreviewPage from "../../components/PreviewPage.astro";
import { loadPreview } from "../../preview.ts";

export const prerender = false;

const result = await loadPreview("posts", Astro.params.slug);
if (result instanceof Response) return result;
Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
---
<PreviewPage view={result} />
