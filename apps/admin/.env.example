# EmDash Node Admin — Environment Variables Example (D12, INF-9)
# Copy to `apps/admin/.env` (or `.env.local`, `.env.production`).
# NEVER commit real secrets or database passwords.

# ------------------------------------------------------------------------------
# 1. Target environment ("local" | "production"; "testing" was retired by INF-10 and is refused at startup)
# ------------------------------------------------------------------------------
# - Only "production" triggers a GitHub repository_dispatch on publish.
# - Anything other than "production" sends `X-Robots-Tag: noindex, nofollow`.
SITE_ENV=local
# SITE_ENV=production additionally requires explicit confirmation and Cloudflare Access (section 8):
ADMIN_CONFIRM_PRODUCTION=
# Project refs (the part after `postgres.` in the pooler user). The target is identified by ref, not by SITE_ENV alone: a URL
# whose ref equals SUPABASE_PRODUCTION_REF always needs ADMIN_CONFIRM_PRODUCTION=yes and Cloudflare Access.
# REQUIRED for any remote database, and the database MUST be that project (there is no other remote environment); startup
# fails closed without it. Production is Supabase project ckpozotzgubrjbjstvjg (promoted from the former testing project).
SUPABASE_PRODUCTION_REF=
# SITE_ENV=local with a remote database is refused unless this is "yes".
ADMIN_ALLOW_REMOTE_DB_WITH_LOCAL=

# ------------------------------------------------------------------------------
# 2. PostgreSQL connection string (Supabase IPv4 session pooler on port 5432)
# ------------------------------------------------------------------------------
# Option A — Local Supabase (`pnpm db:start` on host; reached via host.docker.internal):
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres

# Only ?sslmode= is accepted as a URL query parameter.
# Optional but recommended for a remote (production) database: a FILE PATH to Supabase's CA (literal \n PEMs are rejected); enables verify-full TLS.
DATABASE_CA_CERT=

# Option B — Production Supabase (IPv4 session pooler, port 5432; the host is aws-0-..., copy it from the dashboard):
# DATABASE_URL=postgresql://postgres.<production-project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ------------------------------------------------------------------------------
# 3. EmDash encryption key & public origin (WebAuthn / passkey RP ID)
# ------------------------------------------------------------------------------
# Must match the key used by the target database (generate via `pnpm --filter web exec emdash secrets generate`).
EMDASH_ENCRYPTION_KEY=

# Browser-facing origin of THIS admin instance.
# Passkeys bind to the RP ID (hostname) of EMDASH_SITE_URL:
# - Local Docker: http://localhost:4322
# - Online container host: https://admin.growgen.xyz (or your Altare / Cloudflare Access hostname)
EMDASH_SITE_URL=http://localhost:4322

# Optional comma-separated extra passkey origins sharing the same registrable domain:
EMDASH_ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# 4. First-admin setup wizard gate (fail-closed)
# ------------------------------------------------------------------------------
# Leave empty after initial passkey setup so `/_emdash/admin/setup` and `/_emdash/api/setup`
# stay locked (404). Set a random token only when bootstrapping a fresh database, then visit:
#   <EMDASH_SITE_URL>/_emdash/admin/setup?setup_token=<SETUP_TOKEN>
SETUP_TOKEN=

# ------------------------------------------------------------------------------
# 5. Server & Session configuration
# ------------------------------------------------------------------------------
# restart policy: "no" (default) or "unless-stopped" (fine for local, avoid for production)
ADMIN_RESTART=no
BIND_HOST=127.0.0.1
PORT=4322
# "fs-lite" (persisted in /app/.astro/sessions volume) or "memory"
SESSION_DRIVER=fs-lite

# ------------------------------------------------------------------------------
# 6. Cloudinary media provider (D6)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# 7. GitHub Actions rebuild-on-publish dispatch (D9)
# ------------------------------------------------------------------------------
# Fine-grained PAT with `Contents: write` on GITHUB_DISPATCH_REPO.
# Ignored when SITE_ENV=local.
GITHUB_DISPATCH_TOKEN=
# Expiry date (YYYY-MM-DD) of the PAT above; drives the expiry reminder on /dashboards and the admin dashboard widget (GON-216).
# Config only, never read from the token. Update it when you rotate the token.
GITHUB_DISPATCH_TOKEN_EXPIRES_AT=2027-11-26
GITHUB_DISPATCH_REPO=gongbaodd/blog.gongbushang.com
# Only honoured when SITE_ENV=local (fake GitHub for tests); leave empty otherwise.
GITHUB_API_URL=

# ------------------------------------------------------------------------------
# 8. Cloudflare Access (recommended: Tunnel-only exposure, no published port)
# ------------------------------------------------------------------------------
# When CF_ACCESS_AUD is set every request except /healthz must carry a valid Cf-Access-Jwt-Assertion.
# Mandatory (fail closed, 503) when SITE_ENV=production and the server is not bound to loopback (the container is).
# CF_ACCESS_TEAM_DOMAIN is `<team>` or `<team>.cloudflareaccess.com`; AUD is the Access application's AUD tag.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
