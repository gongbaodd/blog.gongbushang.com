{
  "name": "admin",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --port 4322",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "start": "node ./scripts/start.mjs",
    "smoke": "node ./scripts/smoke.mjs",
    "check:secrets": "node ./scripts/check-import-meta-env.mjs && node ./scripts/check-no-baked-secrets.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --port 4322",
    "typecheck": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/node": "^11.1.0",
    "@astrojs/react": "^7.0.0",
    "astro": "^7.4.13",
    "emdash": "^1.5.0",
    "jose": "6.2.18",
    "pg": "^8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.1"
  }
}
