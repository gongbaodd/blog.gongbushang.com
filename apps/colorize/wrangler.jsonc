{
  "name": "growgen-colorize",
  "main": "./src/index.ts",
  "compatibility_date": "2026-02-24",
  "vars": {
    // Comma-separated allowlist of image hostnames (supports "*.example.com").
    // Set to "*" or remove to allow any public HTTP(S) host (private/loopback/link-local IPs are always blocked).
    "ALLOWED_HOSTS": "res.cloudinary.com"
  }
}
