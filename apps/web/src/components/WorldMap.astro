---
// Placeholder for the maplibre world map (PORT-6). Keeps the legacy wrapper and the data endpoint contract:
// the island will fetch /api/world/map.json and show `cityCount` cities.
interface Props {
	cityCount: number;
}
const { cityCount } = Astro.props;
---

<!-- TODO(PORT-6): <GLMap cityCount={cityCount} client:idle /> from packages/map -->
<div class="cv-deferred" id="world-map" data-city-count={cityCount}></div>

<style>
	.cv-deferred {
		content-visibility: auto;
		contain-intrinsic-size: auto 700px;
	}
</style>
