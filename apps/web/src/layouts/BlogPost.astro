---
// Post layout, ported from packages/layouts/BlogPost.astro. The page (src/pages/[category]/.../[slug].astro)
// does the data work (EmDash entry -> markdown -> headings) and passes plain props here.
// KaTeX styles are only needed on post pages (math rendering).
import "katex/dist/katex.min.css";
import Global from "./Global.astro";
import Header from "../header/Header.astro";
import Footer from "../footer/Footer.astro";
import AdSenseHead from "../ads/AdSenseHead.astro";
import AdSenseSlot from "../ads/AdSenseSlot.astro";
import MantineMain from "../components/MantineMain";
import { GridWithMenu } from "../components/GridWithMenu";
import BlogContent, { BlogMenu, type IHeading, type ILink, type IMenuSeries } from "../components/BlogContent";
import { SITE_TITLE } from "../consts";

interface Props {
	/** Legacy post id `YYYY/MM/DD/slug` (Footer / view count / analytics key). */
	id: string;
	entryId: string;
	title: string;
	description: string;
	/** `YYYY-MM-DD`. */
	date: string;
	category: string;
	tags: string[];
	links: ILink[];
	headings: IHeading[];
	series?: IMenuSeries;
	cover?: { url: string; alt: string };
	readingMinutes: number;
	adsense: boolean;
}

const { id, entryId, title, description, date, category, tags, links, headings, series, cover, readingMinutes, adsense } =
	Astro.props;

const adsenseConsentReady = import.meta.env.PUBLIC_ADSENSE_CONSENT_READY === "true";
// Tag on every post (site review needs to see it); ad units only on opted-in posts.
const adsenseEnabled = import.meta.env.PUBLIC_ADSENSE_ENABLED === "true";
const adsenseTest = import.meta.env.DEV || import.meta.env.PUBLIC_ADSENSE_TEST === "true";
const adsenseSlotId =
	adsense && adsenseConsentReady
		? import.meta.env.PUBLIC_ADSENSE_SLOT_ID?.trim()
		: adsenseTest
			? "0000000000"
			: undefined;
---

<Global
	title={`${SITE_TITLE} | ${title}`}
	description={description}
	image={cover?.url}
	content={{ collection: "posts", id: entryId }}
>
	{(adsenseEnabled || adsenseSlotId) && <AdSenseHead slot="head" />}
	<!-- Post covers & content images are served from Cloudinary. -->
	<link rel="preconnect" href="https://res.cloudinary.com" slot="head" />
	<Header />
	<MantineMain client:load>
		<GridWithMenu menuCol={{ base: 12, lg: 2 }} contentCol={{ base: 12, lg: 10 }} client:load>
			<BlogMenu
				post={{ title, date, cover }}
				links={links}
				headings={headings}
				series={series}
				client:load
				slot="menuNode"
			/>
			<section slot="gridContent">
				<div
					data-post-read
					data-slug={id}
					data-category={category}
					data-year={id.split("/")[0]}
					data-reading-time-min={readingMinutes}
					data-tags={JSON.stringify(tags)}
				>
					<BlogContent title={title} links={links} date={date} time={readingMinutes + "min"} client:load>
						<slot />
					</BlogContent>
				</div>
				{adsenseSlotId && <AdSenseSlot slotId={adsenseSlotId} test={adsenseTest} />}
			</section>
			<aside slot="sidebarNode" class="relates-sidebar">
				<!-- TODO(PORT-6): the related-posts island mounts here (legacy: <RelatePosts id={post.id} client:idle />). -->
				<div id="related-posts" data-post-id={id}></div>
			</aside>
		</GridWithMenu>
		<Footer slug={id} />
	</MantineMain>
</Global>

<script>
  // post_read: fires once per depth (25/50/75/100) per page load, measured over the
  // article wrapper only (not related posts/footer). A passive, rAF-throttled scroll
  // handler computes how far the viewport bottom has travelled through the wrapper,
  // so it works for any post length. Short posts (fully visible on load) reach all
  // thresholds at once; to avoid counting bounces, nothing fires until the tab has been
  // visible for DWELL_MS (2s), after which pending thresholds fire in order.
  import { track } from "@/src/analytics";
  import { newlyReached, readProgress } from "@/src/analytics/read-depth";

  const DWELL_MS = 2000;

  function initPostRead() {
    const el = document.querySelector<HTMLElement>("[data-post-read]");
    if (!el || el.dataset.readInit === "1") return;
    el.dataset.readInit = "1";

    const { slug, category, year, readingTimeMin, tags } = el.dataset;
    if (!slug || !category) return;
    let tagList: string[] = [];
    try {
      tagList = JSON.parse(tags ?? "[]");
    } catch {
      /* ignore */
    }
    const minutes = Number(readingTimeMin);

    const fired = new Set<number>();
    let visibleMs = 0;
    let visibleSince: number | null = document.visibilityState === "visible" ? performance.now() : null;
    let raf = 0;
    let timer = 0;

    const dwellLeft = () =>
      DWELL_MS - visibleMs - (visibleSince === null ? 0 : performance.now() - visibleSince);

    const check = () => {
      raf = 0;
      if (fired.size === 4) return;
      const left = dwellLeft();
      if (visibleSince === null) return; // hidden tab: resume on visibilitychange
      if (left > 0) {
        clearTimeout(timer);
        timer = window.setTimeout(schedule, left + 20);
        return;
      }
      const rect = el.getBoundingClientRect();
      const progress = readProgress(rect.top, rect.height, window.innerHeight);
      for (const depth of newlyReached(progress, fired, rect.height)) {
        fired.add(depth);
        track("post_read", {
          slug,
          category,
          year: year ?? "",
          depth,
          ...(Number.isFinite(minutes) ? { reading_time_min: minutes } : {}),
          ...(tagList.length ? { tags: tagList } : {}),
        });
      }
      if (fired.size === 4) cleanup();
    };
    const schedule = () => {
      if (!raf) raf = requestAnimationFrame(check);
    };
    const onVisibility = () => {
      if (document.visibilityState === "visible") {
        visibleSince = performance.now();
        schedule();
      } else if (visibleSince !== null) {
        visibleMs += performance.now() - visibleSince;
        visibleSince = null;
      }
    };
    function cleanup() {
      window.removeEventListener("scroll", schedule);
      window.removeEventListener("resize", schedule);
      document.removeEventListener("visibilitychange", onVisibility);
      clearTimeout(timer);
    }

    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule, { passive: true });
    document.addEventListener("visibilitychange", onVisibility);
    schedule();
  }

  // Idempotent: guarded by data-read-init on the element, so firing both is safe.
  initPostRead();
  document.addEventListener("astro:page-load", initPostRead);
</script>

<style is:global>
	.description-image {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1rem;
		align-items: start;
	}
	@media (min-width: 48em) {
		.description-image {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>

<style>
	@media (min-width: 75em) {
		.relates-sidebar {
			position: sticky;
			top: 90px;
		}
	}
</style>
