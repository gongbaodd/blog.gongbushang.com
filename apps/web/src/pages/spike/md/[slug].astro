---
import { getEmDashCollection } from "emdash";
import "katex/dist/katex.min.css";
import { renderMarkdown } from "../../../lib/markdown";
export const prerender = true;
export async function getStaticPaths() {
	const { entries } = await getEmDashCollection("posts");
	const withBody = entries.filter((e) => e.data.body_md);
	return Promise.all(
		withBody.map(async (e) => ({
			params: { slug: e.id },
			props: { title: e.data.title, ...(await renderMarkdown(e.data.body_md as string)) },
		})),
	);
}
const { title, html, headings } = Astro.props;
---
<html lang="en"><head><title>{title}</title></head><body>
<h1>{title}</h1>
<nav id="toc"><ul>{headings.map((h) => <li data-depth={h.depth}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul></nav>
<article set:html={html} />
</body></html>
