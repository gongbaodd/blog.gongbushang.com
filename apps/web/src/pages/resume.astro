---
// /resume/ = Universal CV in English (ported from src/pages/resume.astro).
import Global from "../layouts/Global.astro";
import Header from "../header/Header.astro";
import Footer from "../footer/Footer.astro";
import MantineMain from "../components/MantineMain";
import ResumeCom from "../resume/Resume.astro";
import { variants } from "../resume/data";
import { SITE_DESCRIPTION } from "../consts";

export const prerender = true;
---

<Global title={`Resume - Jian Gong - ${variants["universal"].headline["en"]}`} description={SITE_DESCRIPTION}>
	<Header />
	<section>
		<MantineMain>
			<ResumeCom role="universal" language="en" />
			<Footer slug={"resume"} />
		</MantineMain>
	</section>
</Global>
