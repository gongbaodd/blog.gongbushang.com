---
import { getEmDashCollection } from "emdash";
import { Image } from "emdash/ui";
import Global from "../layouts/Global.astro";
import Header from "../header/Header.astro";
import Footer from "../footer/Footer.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";

export const prerender = true;

// TODO(PORT-3+): replace this starter list with the ported home sections (hero, heatmap, blog sections, world map, tags).
const { entries: posts } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 10,
});
---

<Global title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<Header />
	<section id="home-page" class="main" style="max-width:60rem;margin:0 auto;padding:5rem 1rem 1rem;">
		<h1>Recent Posts</h1>

		{
			posts.length === 0 ? (
				<p>No posts yet.</p>
			) : (
				<ul>
					{posts.map((post) => (
						<li>
							<a href={`/posts/${post.id}`}>
								{post.data.featured_image && (
									<div>
										<Image image={post.data.featured_image} />
									</div>
								)}
								<h2>{post.data.title}</h2>
							</a>
							{post.data.excerpt && <p>{post.data.excerpt}</p>}
							{post.data.publishedAt && (
								<time datetime={post.data.publishedAt.toISOString()}>
									{post.data.publishedAt.toLocaleDateString("en-US", {
										year: "numeric",
										month: "long",
										day: "numeric",
									})}
								</time>
							)}
						</li>
					))}
				</ul>
			)
		}
	</section>
	<Footer slug="index" />
</Global>
