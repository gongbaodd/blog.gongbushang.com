---
// Post page at the exact legacy URL: /<category>/<YYYY>/<MM>/<DD>/<slug>/ (D8: legacy_id + category term).
import BlogPost from "../../../../../layouts/BlogPost.astro";
import { getAllPosts, postExcerpt, postLinks, postTitle, quickTitle, seriesNav, type BlogPost as Post } from "../../../../../lib/content";
import { getPostEntries, toClient } from "../../../../../lib/listing";
import { renderMarkdown } from "../../../../../lib/markdown";
import { prepareBody } from "../../../../../lib/mdx-lite";
import { articleModifiedTime, resolvePostSeo } from "../../../../../lib/seo";
import { SITE_AUTHOR } from "../../../../../consts";
import { getReadingTime } from "../../../../../utils/reading-time";

export const prerender = true;

export async function getStaticPaths() {
	const posts = await getAllPosts();
	return posts.map((post) => ({
		params: post.params,
		props: { post, series: seriesNav(post, posts, quickTitle) },
	}));
}

interface Props {
	post: Post;
	series: ReturnType<typeof seriesNav>;
}
const { post, series } = Astro.props;

const prepared = prepareBody(post.body);
if (prepared.warnings.length) console.warn(`[post ${post.id}] ${prepared.warnings.join("; ")}`);
const { html, headings, menuHeadings } = await renderMarkdown(prepared.body, { mdx: prepared.mdx });

// Sidebar cover card: the same client post the listings and /api/cards use (legacy mapServerPostToClient).
const entry = (await getPostEntries()).find((e) => e.id === post.id);
if (!entry) throw new Error(`[post ${post.id}] no listing entry`);
const clientPost = await toClient(entry);

const title = postTitle(post, headings);
const description = await postExcerpt(post.body);
const { minutes } = getReadingTime(post.body);

// GON-203: SEO-panel overrides (loaded once for the whole collection by getAllPosts) resolved through getSeoMeta().
const seo = resolvePostSeo({
	title,
	description,
	image: post.data.cover?.url,
	seo: post.seo,
	siteUrl: Astro.site?.origin,
	path: post.href,
});
// Legacy `YYYY-MM-DD` is the real publish date (the CMS published_at is the import time).
const articleMeta = {
	publishedTime: post.date,
	modifiedTime: articleModifiedTime(post),
	author: post.author ?? SITE_AUTHOR,
};
---

<BlogPost
	id={post.id}
	entryId={post.entryId}
	dbId={post.dbId}
	title={title}
	seo={seo}
	articleMeta={articleMeta}
	date={post.date}
	category={post.data.category}
	tags={post.data.tag ?? []}
	links={postLinks(post)}
	headings={menuHeadings}
	series={series}
	clientPost={clientPost}
	readingMinutes={minutes}
	adsense={post.data.adsense}
>
	<Fragment set:html={html} />
</BlogPost>
