---
import BlogListPage from "../../components/BlogListPage.astro";
import { FILTER_ENTRY } from "../../consts-list";
import { tagPages } from "../../lib/listing";

export const prerender = true;
export const getStaticPaths = tagPages;

const { filter } = Astro.params;
const { posts, tagName } = Astro.props;
---

<BlogListPage
	subTitle={tagName}
	totalCount={posts.length}
	filter={filter!}
	entryType={FILTER_ENTRY.TAG}
	posts={posts}
/>
