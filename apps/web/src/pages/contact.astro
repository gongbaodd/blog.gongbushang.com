---
import { SITE_TITLE } from "../consts";
import Global from "../layouts/Global.astro";
import MantineMain from "../components/MantineMain";
import Header from "../header/Header.astro";
import Footer from "../footer/Footer.astro";
import Follow from "../follow/Follow.astro";

export const prerender = true;
---

<Global
  title={`${SITE_TITLE} | Contact`}
  description="How to contact Gong and where to follow new posts, projects and podcast episodes."
>
  <Header />
  <section id="contact-page" class="main">
    <MantineMain>
      <h1 class="mx-auto mt-10 max-w-5xl px-4 text-3xl font-bold">Contact</h1>
      <Follow />
      <Footer slug={"contact"} />
    </MantineMain>
  </section>
</Global>
