---
// /year/: archive folders per year (ported from src/pages/year.astro).
import Global from "../layouts/Global.astro";
import Header from "../header/Header.astro";
import Footer from "../footer/Footer.astro";
import MantineMain from "../components/MantineMain";
import YearFolders from "../components/YearFolders.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";

export const prerender = true;
---

<Global title={`${SITE_TITLE} | Archive`} description={SITE_DESCRIPTION}>
	<Header />
	<section id="year-page" class="main">
		<MantineMain client:load>
			<!-- TODO(search story): <SearchBanner client:idle /> from packages/search -->
			<YearFolders />
			<Footer />
		</MantineMain>
	</section>
</Global>
