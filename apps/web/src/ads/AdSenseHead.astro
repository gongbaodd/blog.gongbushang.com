---
// Ported from packages/ads/AdSenseHead.astro. Renders only on a production build (or `astro dev`):
// testing/local deployments never load ad scripts (PORT-7, same SITE_ENV switch as noindex).
import { isProductionBuild } from "../analytics/env";

const enabled = isProductionBuild() || import.meta.env.DEV;
---

{
  enabled && (
    <>
      <script is:inline>
        window.googlefc = window.googlefc || {};
        window.googlefc.callbackQueue = window.googlefc.callbackQueue || [];
      </script>
      <script
        is:inline
        async
        src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7617483459228974"
        crossorigin="anonymous"
      />
    </>
  )
}
