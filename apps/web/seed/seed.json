					"label": "Threads",
					"url": "https://www.threads.com/@mia_takeshi",
					"target": "_blank",
					"cssClasses": "threads"
				},
				{
					"type": "custom",
					"label": "Spotify",
					"url": "https://open.spotify.com/show/2FJoLvI0tAnjXO3t71Iswz",
					"target": "_blank",
					"cssClasses": "spotify"
				},
				{
					"type": "custom",
