{
	"$schema": "https://emdashcms.com/seed.schema.json",
	"version": "1",
	"meta": {
		"name": "Starter",
		"description": "A minimal EmDash starter with posts and pages",
		"author": "EmDash"
	},
	"settings": {
		"title": "My Site",
		"tagline": "Built with EmDash"
	},
	"collections": [
		{
			"slug": "posts",
			"label": "Posts",
			"labelSingular": "Post",
			"urlPattern": "/posts/{slug}",
			"supports": ["drafts", "revisions", "preview", "search", "seo"],
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "featured_image",
					"label": "Featured Image",
					"type": "image"
				},
				{
					"slug": "content",
					"label": "Content",
					"type": "portableText",
					"searchable": true,
					"widget": "post-fields:hidden"
				},
				{
					"slug": "excerpt",
					"label": "Excerpt",
					"type": "text",
					"widget": "post-fields:hidden"
				}
			]
		},
		{
			"slug": "pages",
			"label": "Pages",
			"labelSingular": "Page",
			"urlPattern": "/{slug}",
			"supports": ["drafts", "revisions", "preview", "search", "seo"],
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "content",
					"label": "Content",
					"type": "portableText",
					"searchable": true
				}
			]
		}
	],
	"taxonomies": [
		{
			"name": "category",
			"label": "Categories",
			"labelSingular": "Category",
			"hierarchical": true,
			"collections": ["posts"],
			"terms": [
				{
					"slug": "general",
					"label": "General"
				},
				{
					"slug": "updates",
					"label": "Updates"
				}
			]
		},
		{
			"name": "tag",
			"label": "Tags",
			"labelSingular": "Tag",
			"hierarchical": false,
			"collections": ["posts"],
			"terms": [
				{
					"slug": "starter",
					"label": "Starter"
				},
				{
					"slug": "example",
					"label": "Example"
				}
			]
		},
		{
			"name": "social",
			"label": "Social links",
			"items": [
				{
					"type": "custom",
					"label": "Mail",
					"url": "mailto:gongbaodd@outlook.com",
					"target": "_blank",
					"cssClasses": "mail"
				},
				{
					"type": "custom",
					"label": "GitHub",
					"url": "https://github.com/gongbaodd",
					"target": "_blank",
					"cssClasses": "github"
				},
				{
					"type": "custom",
					"label": "Twitter",
					"url": "https://twitter.com/gongbaodd",
					"target": "_blank",
					"cssClasses": "x"
				},
				{
					"type": "custom",
					"label": "Instagram",
					"url": "https://www.instagram.com/mia_takeshi",
					"target": "_blank",
					"cssClasses": "instagram"
				},
				{
