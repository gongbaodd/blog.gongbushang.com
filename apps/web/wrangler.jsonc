{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Top level = production placeholder. Production Hyperdrive/KV ids are created at CUT-1 (INF-4).
	// Wrangler does not inherit bindings into `env.*`, so each env repeats them.
	// Select an env at build time with CLOUDFLARE_ENV=testing (the Astro adapter bakes it into dist/server/wrangler.json).
	"name": "growgen-web",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			// Real production id is set at CUT-1. Placeholder is only valid for local dev and --dry-run.
			"id": "00000000000000000000000000000000",
			"localConnectionString": "postgresql://postgres:postgres@127.0.0.1:54322/postgres",
		},
	],
	// Co-editing rooms, one Durable Object per entry being edited
	"durable_objects": {
		"bindings": [{ "name": "EMDASH_ROOMS", "class_name": "EmDashRoom" }],
	},
	"exports": {
		"EmDashRoom": { "type": "durable-object", "storage": "sqlite" },
	},
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// Runs EmDash runScheduledTasks (publishes scheduled posts, housekeeping) and keeps Supabase from pausing.
	"triggers": {
		"crons": ["*/5 * * * *"],
	},
	"vars": {
		// "production" serves indexable pages; anything else gets noindex headers + disallow-all robots.txt
		// (written into dist/client by scripts/post-build.mjs).
		"SITE_ENV": "production",
	},
	"env": {
		"testing": {
			"name": "growgen-web-testing",
			"workers_dev": true,
			"preview_urls": false,
			"vars": { "SITE_ENV": "testing" },
			"hyperdrive": [
				{
					"binding": "HYPERDRIVE",
					// Hyperdrive config growgen-testing-db (caching disabled)
					"id": "319cee5eca8a4c47a00b2091cff565f3",
					"localConnectionString": "postgresql://postgres:postgres@127.0.0.1:54322/postgres",
				},
			],
			"kv_namespaces": [{ "binding": "SESSION", "id": "55d3e3f70475477a9eef931679726407" }],
			"durable_objects": {
				"bindings": [{ "name": "EMDASH_ROOMS", "class_name": "EmDashRoom" }],
			},
			"triggers": { "crons": ["*/15 * * * *"] },
		},
	},
}
