# Copy to apps/web/.dev.vars (gitignored). No real secrets here.
# `pnpm admin:<env>` never edits this file: it only reads it and writes a generated .dev.vars.admin-<env> (docs/plan/emdash/runbooks/admin.md).
# For testing/production the DB URL, key and SITE_ENV come from the repo-root .env; GITHUB_DISPATCH_* and CLOUDINARY_* may live here or in .env (.env wins).
# Local Hyperdrive target for `astro dev` / `wrangler dev` / `emdash migrate --from-config`
# (same value as hyperdrive.localConnectionString in wrangler.jsonc; Supabase local default).
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Generated by `create emdash` into apps/web/.env; must be a 32-byte secret (see EmDash docs). Never commit.
EMDASH_ENCRYPTION_KEY=
# Cloudinary media provider (D6). Worker secrets in deployed envs (`wrangler secret put`).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# rebuild-on-publish plugin (D9). Token = fine-grained PAT, Contents: write on the repo. Unset token => plugin no-ops.
GITHUB_DISPATCH_TOKEN=
GITHUB_DISPATCH_REPO=gongbaodd/blog.gongbushang.com
# Optional override (local testing against a fake GitHub); default https://api.github.com
GITHUB_API_URL=
# Worker secret gating the first-admin setup wizard (src/middleware.ts). Unset => setup closed in deployed envs.
SETUP_TOKEN=
# "production" = indexable; anything else = noindex + disallow-all robots.txt (wrangler vars.SITE_ENV)
SITE_ENV=local
# Build-time (not Worker secrets): analytics/ads run only when SITE_ENV=production at build time
PUBLIC_MIXPANEL_TOKEN=
PUBLIC_MIXPANEL_API_HOST=
PUBLIC_ADSENSE_ENABLED=
PUBLIC_ADSENSE_CONSENT_READY=
PUBLIC_ADSENSE_SLOT_ID=
