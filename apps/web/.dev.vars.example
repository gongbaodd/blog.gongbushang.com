# Copy to apps/web/.dev.vars (gitignored). No real secrets here.
# Local Hyperdrive target for `astro dev` / `wrangler dev` / `emdash migrate --from-config`
# (same value as hyperdrive.localConnectionString in wrangler.jsonc; Supabase local default).
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Generated by `create emdash` into apps/web/.env; must be a 32-byte secret (see EmDash docs). Never commit.
EMDASH_ENCRYPTION_KEY=
