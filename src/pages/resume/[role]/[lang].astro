---
import BaseHead from "@/packages/components/BaseHead.astro";
import { SITE_DESCRIPTION } from "@/packages/consts";
import Global from "@/packages/layouts/Global.astro";
import MantineMain from "@/packages/scaffold/MantineMain";
import Header from "@/packages/header/Header.astro";
import Footer from "@/packages/footer/Footer.astro";
import ResumeCom from "@/packages/resume/Resume.astro";
import { resumeLanguages, resumeRoles, variants, type ResumeLanguage, type ResumeRole } from "@/packages/resume/data";

export function getStaticPaths() {
  return resumeRoles.flatMap((role) =>
    resumeLanguages
      .filter((language) => !(role === "universal" && language === "en"))
      .map((language) => ({ params: { role, lang: language } })),
  );
}

const { role, lang: language } = Astro.params as { role: ResumeRole; lang: ResumeLanguage };
---

<Global>
  <BaseHead
    title={`Resume - Jian Gong - ${variants[role].headline[language]}`}
    description={SITE_DESCRIPTION}
    slot="head"
  />
  <Header />

  <section>
    <MantineMain>
      <ResumeCom role={role} language={language} />
      <Footer slug={"resume"} />
    </MantineMain>
  </section>
</Global>
