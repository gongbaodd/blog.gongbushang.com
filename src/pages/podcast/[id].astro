---
import BaseHead from "@/packages/components/BaseHead.astro";
import Footer from "@/packages/footer/Footer.astro";
import Header from "@/packages/header/Header.astro";
import Global from "@/packages/layouts/Global.astro";
import MantineMain from "@/packages/scaffold/MantineMain";
import { SITE_TITLE } from "@/packages/consts";
import { GridWithMenu } from "@/packages/scaffold/GridWithMenu";
import { processPodcastEpisodes, readPodcastData } from "@/packages/utils/podcast";
import { findNearest } from "@/packages/utils/nearest";
import PodcastEpisodeMenu from "../../components/PodcastEpisodeMenu";
import PodcastEpisodeContent from "../../components/PodcastEpisodeContent";
import PodcastDiscover from "../../components/PodcastDiscover";
import { stripHtml } from "@/packages/card/stripHtml";

export const prerender = true;

export function getStaticPaths() {
  const episodes = processPodcastEpisodes();
  const candidates = episodes.map((e) => ({ ...e, category: { label: "podcast" } }));
  // Episodes also carry large `embeddings`/`umap2D` data; strip them before they reach island props.
  const slim = ({ id, title, link, pubDate, summary, description, duration, audioUrl, image, colorSet }: (typeof episodes)[number]) => ({
    id, title, link, pubDate, summary, description, duration, audioUrl, image, colorSet,
  });
  return episodes.map((episode) => {
    const target = candidates.find((c) => c.id === episode.id)!;
    return {
      params: { id: episode.id },
      props: {
        episode: slim(episode),
        related: findNearest(target, candidates, 4).map(slim),
      },
    };
  });
}

const { episode, related } = Astro.props;
const channel = readPodcastData().channel;
const description = stripHtml(episode.description || episode.summary || "");
const metaDescription = stripHtml(episode.summary || description).slice(0, 200);
const publishedDate = new Date(episode.pubDate);
---

<Global>
  <BaseHead
    title={`${episode.title} | ${SITE_TITLE}`}
    description={metaDescription}
    image={episode.image}
    slot="head"
  />
  <Header />
  <MantineMain client:load>
    <GridWithMenu menuCol={{ base: 12, lg: 2 }} contentCol={{ base: 12, lg: 10 }}>
      <PodcastEpisodeMenu
        slot="menuNode"
        client:load
        title={channel.title}
        description={channel.description}
        link={channel.link}
        image={channel.image}
      />
      <section slot="gridContent">
        <PodcastEpisodeContent
          title={episode.title}
          date={publishedDate.toISOString()}
          duration={episode.duration}
          image={episode.image}
          description={description}
          link={episode.link}
        />
      </section>
      <aside slot="sidebarNode" class="relates-sidebar">
        <PodcastDiscover episodes={related} client:idle />
      </aside>
    </GridWithMenu>
    <Footer slug="podcast" />
  </MantineMain>
</Global>

<style>
  @media (min-width: 75em) {
    .relates-sidebar {
      position: sticky;
      top: 90px;
    }
  }
</style>
