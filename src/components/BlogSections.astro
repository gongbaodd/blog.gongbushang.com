---
import GridHalf from "@/packages/scaffold/GridHalf";
import { HistoryCarousel, LatestCarousel } from "@/packages/carousel/BlogCarousel";
import { INITIAL_SSR_POSTS } from "@/packages/consts";
import { getHistoryCards, getLatestCards } from "@/packages/utils/cards";
import { getAllPosts } from "@/packages/utils/post";

const [latest, history, all] = await Promise.all([
  getLatestCards(INITIAL_SSR_POSTS),
  getHistoryCards(INITIAL_SSR_POSTS),
  getAllPosts(),
]);
---

<!-- Below the fold: defer hydration and skip layout/paint until near the viewport -->
<div class="cv-deferred">
  <GridHalf>
    <LatestCarousel slot="left" initialPosts={latest} totalCount={all.length} client:visible />
    <HistoryCarousel slot="right" initialPosts={history} client:visible />
  </GridHalf>
</div>

<style>
  .cv-deferred {
    content-visibility: auto;
    contain-intrinsic-size: auto 600px;
  }
</style>
