---
import GridHalf from "@/packages/scaffold/GridHalf";
import { HistoryCarousel, LatestCarousel } from "@/packages/carousel/BlogCarousel";

---

<!-- Below the fold: defer hydration and skip layout/paint until near the viewport -->
<div class="cv-deferred">
  <GridHalf>
    <LatestCarousel slot="left" client:visible />
    <HistoryCarousel slot="right" client:visible />
  </GridHalf>
</div>

<style>
  .cv-deferred {
    content-visibility: auto;
    contain-intrinsic-size: auto 600px;
  }
</style>
