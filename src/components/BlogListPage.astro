---
import Global from "@/packages/layouts/Global.astro";
import BaseHead from "@/packages/components/BaseHead.astro";
import {
  SITE_DESCRIPTION,
  SITE_TITLE,
  FILTER_ENTRY,
  INITIAL_SSR_POSTS,
  ROUTE_LABEL,
} from "@/packages/consts";
import MantineMain from "@/packages/scaffold/MantineMain";
import Footer from "@/packages/footer/Footer.astro";
import { BlogListMenu } from "@/packages/menu/BlogListMenu";
import Header from "@/packages/header/Header.astro";
import { GridWithMenu } from "@/packages/scaffold/GridWithMenu";
import BlogPlock from "@/packages/masonry/BlogPlock";
import { mapServerPostToClient, type T_PROPS } from "@/packages/utils/post";

interface Props {
  subTitle: string;
  totalCount: number;
  filter: string;
  entryType?: FILTER_ENTRY;
  /** Sorted posts of this list; the first few are rendered into the HTML. */
  posts?: T_PROPS[];
}

const {
  subTitle,
  filter,
  entryType,
  totalCount,
  posts = [],
} = Astro.props;

const initialPosts = await mapServerPostToClient(posts.slice(0, INITIAL_SSR_POSTS));

---

<Global>
  <BaseHead
    title={`${SITE_TITLE} | ${subTitle}`}
    description={SITE_DESCRIPTION}
    slot="head"
  />
  <Header transition:persist />
  <section id="blog-page" class="main">
    <MantineMain client:load>
      <GridWithMenu
        menuCol={{ base: 12, md: 1.2 }}
        contentCol={{ base: 12, md: 10.8 }}
      >
        <BlogListMenu slot="menuNode" client:load />
        <BlogPlock 
          totalCount={totalCount} 
          initialPosts={initialPosts}
          entryType={entryType}
          filter={filter}
          slot="gridContent" 
          client:load 
        />
      </GridWithMenu>
      <Footer slug={filter} />
    </MantineMain>
  </section>
</Global>
