{
  "name": "gongbaodd-blog",
  "version": "0.0.1",
  "private": true,
  "license": "GPL-3.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.test.tsx'",
    "test:watch": "vitest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "fetch:podcast": "pnpm --filter fetch-podcast fetch-podcast",
    "umap:build": "cargo build --release --manifest-path packages/umap/Cargo.toml",
    "umap:test": "cargo test -p umap",
    "db:start": "supabase start -x gotrue,realtime,storage-api,imgproxy,kong,mailpit,postgrest,studio,edge-runtime,logflare,vector,supavisor,postgres-meta",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "content:pull": "node apps/web/scripts/sync/pull.mjs",
    "deploy:production:build": "node apps/web/scripts/admin/check-build-env.mjs production && set -a && . ./.env && set +a && cd apps/web && SITE_ENV=production CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=\"$SUPABASE_PRODUCTION_POOLER_URL\" pnpm build",
    "admin:local": "node apps/web/scripts/admin/start.mjs local",
    "admin:production": "node apps/web/scripts/admin/start.mjs production",
    "admin:stop": "node apps/web/scripts/admin/start.mjs stop",
    "deploy:production:dry-run": "cd apps/web && pnpm exec wrangler deploy --dry-run --outdir ../../tmp/wrangler-dry -c dist/server/wrangler.json"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/react": "^6.0.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@mantine/carousel": "^9.2.1",
    "@mantine/charts": "^9.2.1",
    "@mantine/core": "^9.2.1",
    "@mantine/hooks": "^9.2.1",
    "@mantine/spotlight": "^9.2.1",
    "@musical-sniffle/sobel-edge-detection": "1.0.0-beta.1",
    "@nanostores/react": "^1.1.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@react-three/rapier": "^2.2.0",
    "@tabler/icons-react": "^3.34.1",
    "ascii-reveal": "^0.3.0",
    "astro": "7.3.3",
    "astro-mermaid": "^2.1.0",
    "chroma-js": "^3.1.2",
    "dayjs": "^1.11.13",
    "es-toolkit": "^1.39.8",
    "excerpt": "^0.0.1",
    "fs": "0.0.1-security",
    "katex": "^0.16.22",
    "lucide-react": "^1.16.0",
    "maplibre-gl": "^5.24.0",
    "mermaid": "^11.11.0",
    "minisearch": "^7.1.2",
    "mixpanel-browser": "^2.86.0",
    "nanostores": "^1.0.1",
    "node-vibrant": "^4.0.3",
    "path": "^0.12.7",
    "potrace": "^2.1.8",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-map-gl": "^8.0.4",
    "react-plock": "^3.5.1",
    "recharts": "^3.2.1",
    "rehype-external-links": "^3.0.0",
    "rehype-katex": "^7.0.0",
    "remark-attributes": "^0.3.2",
    "remark-math": "^6.0.0",
    "shiki-plantuml": "file:./packages/shiki-plantuml",
    "tailwindcss": "^3.4.1",
    "three": "^0.167.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "autoprefixer": "^10.4.21",
    "jsdom": "^30.1.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.6",
    "puppeteer-core": "^25.11.0",
    "sharp": "^0.34.3",
    "shiki": "^4.1.0",
    "tsx": "^4.23.15",
    "vite-plugin-glsl": "^1.6.1",
    "vitest": "^5.0.1",
    "wrangler": "^4.132.0"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "overrides": {
      "@dimforge/rapier3d-compat": "0.19.2"
    }
  }
}
